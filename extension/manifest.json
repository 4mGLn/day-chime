{
  "manifest_version": 3,
  "name": "Day Chime — 근태 읽기",
  "version": "0.4.0",
  "description": "다우오피스 홈의 출퇴근 시각만 로컬 Day Chime에 전달합니다.",
  "permissions": [
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Day Chime 연결 상태",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://example.daouoffice.com/home*"
      ],
      "js": [
        "site.js",
        "reader.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
